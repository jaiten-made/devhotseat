# Postgres connection for the dev database. This one holds transcripts worth
# keeping, so migrations are applied to it with drizzle-kit migrate, never push.
DATABASE_URL=postgres://devhotseat:devhotseat@localhost:5432/devhotseat
# AI Provider: "local" (e.g. Ollama/LM Studio) or "gemini" (Google Gemini API).
# If omitted, defaults to "gemini" when GEMINI_API_KEY is present, or "local" when not.
AI_PROVIDER=local

# Local AI configuration (Ollama default: http://localhost:11434, LM Studio: http://localhost:1234/v1)
LOCAL_AI_BASE_URL=http://localhost:11434
LOCAL_AI_MODEL=llama3.2

# Google Gemini API key (optional if using local AI). Get one at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Postgres connection for the integration test database. Truncated between
# tests, so never point this at the dev database.
TEST_DATABASE_URL=postgres://devhotseat:devhotseat@localhost:5432/devhotseat_test

# Port the API server listens on.
PORT=3000
