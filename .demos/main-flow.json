{
  "name": "main-flow",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "hide": [
    ".tsqd-parent-container",
    ".tsqd-open-btn-container"
  ],
  "steps": [
    {
      "action": "goto",
      "path": "/questions",
      "caption": "Every question you want to practise",
      "hold": 500
    },
    {
      "action": "type",
      "testid": "question-input",
      "text": "Tell me about a time you missed a deadline.",
      "caption": "Add them by hand",
      "hold": 400
    },
    {
      "action": "click",
      "testid": "add-question",
      "caption": "It lands in the bank",
      "hold": 500
    },
    {
      "action": "click",
      "testid": "new-session",
      "caption": "A session draws on the ones you tick",
      "hold": 500
    },
    {
      "action": "click",
      "testid": "start-session",
      "caption": "Take the lot, or just your weak spots",
      "hold": 600
    },
    {
      "action": "click",
      "testid": "turn-bar",
      "caption": "The room runs it like a call",
      "hold": 600
    },
    {
      "action": "click",
      "testid": "use-typing",
      "caption": "Answer out loud, or type instead",
      "hold": 500
    },
    {
      "action": "type",
      "testid": "answer-input",
      "text": "I underestimated a data migration, and said so the week I knew.",
      "caption": "",
      "hold": 400
    },
    {
      "action": "click",
      "testid": "turn-bar",
      "caption": "Hand the turn back",
      "hold": 600
    },
    {
      "action": "goto",
      "path": "/sessions/d3305eed-0000-4000-8000-00000000de00",
      "caption": "Afterwards it scores what you said",
      "hold": 700
    },
    {
      "action": "scroll",
      "testid": "report-radar",
      "caption": "Five STAR-L pillars, weighted",
      "hold": 700
    },
    {
      "action": "scroll",
      "testid": "report-radar",
      "by": 700,
      "caption": "Then a card per answer",
      "hold": 700
    },
    {
      "action": "goto",
      "path": "/",
      "caption": "A square for every day you practise",
      "hold": 600
    },
    {
      "action": "hover",
      "testid": "streak-stats",
      "caption": "The part that makes you better",
      "hold": 900,
      "captionAt": "top"
    }
  ]
}
